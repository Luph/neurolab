% pfbook.sty -- house style for "Project Finance: The Complete Practice"
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pfbook}[2026/10/03 Project finance book style]

% ---------- Engine, fonts, language ----------
\RequirePackage{iftex}
\RequireLuaTeX
\RequirePackage{fontspec}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{unicode-math}
\setmainfont{TeX Gyre Pagella}
\setsansfont{TeX Gyre Heros}[Scale=MatchLowercase]
\setmonofont{DejaVu Sans Mono}[Scale=0.84]
\setmathfont{TeX Gyre Pagella Math}
\RequirePackage[english]{babel}
\RequirePackage{microtype}

% ---------- Page ----------
\RequirePackage[paperwidth=7in,paperheight=10in,inner=0.95in,outer=0.8in,top=0.9in,bottom=0.95in]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{emptypage}
\setlength{\parskip}{0pt}
\setlength{\parindent}{1.2em}

% ---------- Color, graphics, diagrams ----------
\RequirePackage[dvipsnames,svgnames,table]{xcolor}
\definecolor{pfblue}{HTML}{1F4E79}
\definecolor{pfgray}{HTML}{595959}
\definecolor{pflight}{HTML}{EEF3F8}
\definecolor{pfinput}{HTML}{FFF2CC}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta,shapes.geometric,shapes.misc,shapes.multipart,fit,calc,backgrounds,decorations.pathreplacing,matrix,chains,shadows}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\tikzset{
  pfbox/.style={draw=pfblue,fill=pflight,rounded corners=2pt,align=center,font=\small\sffamily,inner sep=4pt,minimum height=7mm},
  pfgov/.style={pfbox,fill=Goldenrod!20},
  pflend/.style={pfbox,fill=SeaGreen!15},
  pfspv/.style={pfbox,fill=pfblue!25,very thick},
  pfarrow/.style={-{Stealth[length=2mm]},thick,pfgray},
  pfflow/.style={-{Stealth[length=2mm]},very thick,pfblue},
  pflabel/.style={font=\scriptsize\sffamily,fill=white,inner sep=1pt}
}

% ---------- Tables ----------
\RequirePackage{booktabs,tabularx,longtable,multirow,makecell,array,colortbl}
\RequirePackage[group-separator={,},group-minimum-digits=4]{siunitx}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}
\renewcommand{\arraystretch}{1.15}

% ---------- Floats: exhibits ----------
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{newfloat}
\DeclareFloatingEnvironment[fileext=loe,listname={List of Exhibits},name=Exhibit,placement=htbp,within=chapter]{exhibit}
\captionsetup{font=small,labelfont={bf,sf},labelsep=period,justification=raggedright,singlelinecheck=false}
\captionsetup[exhibit]{position=top}

% ---------- Lists ----------
\RequirePackage{enumitem}
\setlist{itemsep=2pt,topsep=4pt}

% ---------- Boxes ----------
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{breakable,skins}

% Counters reset per chapter
\newcounter{pfexample}[chapter]\renewcommand{\thepfexample}{\thechapter.\arabic{pfexample}}
\newcounter{pfclause}[chapter]\renewcommand{\thepfclause}{\thechapter.\arabic{pfclause}}
\newcounter{pfexercise}[chapter]\renewcommand{\thepfexercise}{\thechapter.\arabic{pfexercise}}

% Example k.n: \begin{example}{Title}  (title may include "Illustrative" via \illustrative)
\newenvironment{example}[1]{%
  \refstepcounter{pfexample}%
  \par\medskip\noindent{\sffamily\bfseries\color{pfblue}Example~\thepfexample\quad #1}\par\nopagebreak\smallskip%
}{\par\noindent\hfill{\color{pfblue}\rule{2em}{0.4pt}}\par\medskip}
\newcommand{\illustrative}{\textsc{\textcolor{pfgray}{(Illustrative)}}}

% Drafted clause excerpt: \begin{clause}{Title}
\newtcolorbox{pfclausebox}[1]{breakable,enhanced,colback=white,colframe=pfgray,boxrule=0.5pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,fonttitle=\sffamily\bfseries\small,coltitle=black,colbacktitle=pflight,
  title={Clause~\thepfclause\quad #1},fontupper=\small}
\newenvironment{clause}[1]{\refstepcounter{pfclause}\begin{pfclausebox}{#1}}{\end{pfclausebox}}

% Status labels (match \illustrative)
\newcommand{\casep}{\textsc{\textcolor{pfgray}{(Case P)}}}
\newcommand{\caset}{\textsc{\textcolor{pfgray}{(Case T)}}}
\newcommand{\caser}{\textsc{\textcolor{pfgray}{(Case R)}}}
\newcommand{\realcase}[1]{\textsc{\textcolor{pfgray}{(Real case: #1)}}}

% Exhibit source and note lines
\newcommand{\exhibitsource}[1]{\par\smallskip{\footnotesize\sffamily\raggedright Source: #1\par}}
\newcommand{\exhibitnote}[1]{\par{\footnotesize\sffamily\raggedright Note: #1\par}}

% Clause variants: \begin{clausevariants}\label{cl:N.K} ... \begin{clausevariant}{Title}{Status}\label{cl:N.Ka}
\newcounter{pfclausevar}[pfclause]
\renewcommand{\thepfclausevar}{\thepfclause\alph{pfclausevar}}
\newtcolorbox{pfclausevarbox}[2]{breakable,enhanced,colback=white,colframe=pfgray,boxrule=0.5pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,fonttitle=\sffamily\bfseries\small,coltitle=black,colbacktitle=pflight,
  title={Clause~\thepfclausevar\quad #1\quad\textmd{\textsc{(#2)}}},fontupper=\small}
\newenvironment{clausevariants}{\refstepcounter{pfclause}}{}
\newenvironment{clausevariant}[2]{\refstepcounter{pfclausevar}\begin{pfclausevarbox}{#1}{#2}}{\end{pfclausevarbox}}

% Numbered framework box (replaces the current \newtcolorbox{framework})
% Usage: \begin{framework}[label={fw:slug}]{Name}
\newtcolorbox[auto counter,number within=chapter]{framework}[2][]{%
  breakable,enhanced,colback=pflight,colframe=pfblue,boxrule=0.8pt,
  fonttitle=\sffamily\bfseries,title={Framework~\thetcbcounter\quad #2},left=6pt,right=6pt,#1}

% Running-case scene (replaces the current casescene: its "attach title to upper"
% title did not render in the test build; this version prints it as the first line,
% and parbox=false gives normal paragraph indents instead of hanging lines)
\newtcolorbox{casescene}[2]{breakable,enhanced,parbox=false,colback=white,colframe=pfblue!50,boxrule=0pt,
  leftrule=2.5pt,arc=0pt,left=8pt,right=4pt,top=2pt,bottom=2pt,
  before upper={{\sffamily\small\color{pfblue}#1\ \textperiodcentered\ #2}\par\smallskip}}

% Sources list with hanging indent
\newenvironment{sources}{\begin{list}{}{\setlength{\leftmargin}{1.5em}%
  \setlength{\itemindent}{-1.5em}\setlength{\itemsep}{3pt}\small}\raggedright}{\end{list}}

% Long tables numbered as exhibits
\def\LTcaptype{exhibit}

% Landscape pages for wide model printouts
\RequirePackage{pdflscape}

% Excel formulas
\RequirePackage{listings}
\lstdefinestyle{excel}{basicstyle=\ttfamily\small,columns=fullflexible,keepspaces=true,breaklines=true,
  breakatwhitespace=false,frame=l,framerule=1.5pt,rulecolor=\color{SeaGreen},xleftmargin=1em,
  backgroundcolor=\color{SeaGreen!5},aboveskip=4pt,belowskip=6pt,upquote=true,literate={-}{-}1}
\lstnewenvironment{excel}{\lstset{style=excel}}{}
\newcommand{\xl}[1]{\lstinline[style=excel,basicstyle=\ttfamily\small]{#1}}
\lstdefinestyle{python}{language=Python,basicstyle=\ttfamily\footnotesize,columns=fullflexible,keepspaces=true,
  breaklines=true,frame=single,rulecolor=\color{pfgray},backgroundcolor=\color{gray!4}}

% Exercises and solutions
% \begin{exercise}  ... \end{exercise}  (inside a tier subsection)
\newenvironment{exercise}{\refstepcounter{pfexercise}\par\medskip\noindent{\sffamily\bfseries Exercise~\thepfexercise}\quad}{\par}
% \begin{solution}{<label of exercise>} ... \end{solution}
\newenvironment{solution}[1]{\par\medskip\noindent{\sffamily\bfseries Solution to Exercise~\ref{#1}}\quad}{\par}

% Units and money helpers
\newcommand{\USDm}[1]{USD~#1~million}
\RequirePackage{xspace}
\newcommand{\bps}{\,bps\xspace}
\newcommand{\x}{\texttimes\xspace}

% Defined terms: bold at first definition only
\newcommand{\term}[1]{\textbf{#1}}

% Headings
\titleformat{\chapter}[display]{\sffamily\bfseries\color{pfblue}}{\large Chapter \thechapter}{4pt}{\Huge}
\titlespacing*{\chapter}{0pt}{-10pt}{24pt}
\titleformat{\section}{\sffamily\bfseries\Large\color{pfblue}}{\thesection}{0.8em}{}
\titleformat{\subsection}{\sffamily\bfseries\large}{\thesubsection}{0.8em}{}
\titleformat{\subsubsection}{\sffamily\bfseries\normalsize}{}{0em}{}
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{1}

% Parts
\titleformat{\part}[display]{\centering\sffamily\bfseries\color{pfblue}}{\Large Part \thepart}{10pt}{\Huge}

% Header/footer
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\sffamily\thepage\quad\leftmark}
\fancyhead[RO]{\small\sffamily\rightmark\quad\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\chaptermark}[1]{\markboth{Chapter \thechapter\quad #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\quad #1}}

% Hyperlinks and cross-references (load last)
\RequirePackage[hidelinks,bookmarksnumbered]{hyperref}
\RequirePackage{xurl}
\RequirePackage[capitalise,noabbrev,nameinlink]{cleveref}
\crefname{pfexample}{Example}{Examples}
\crefname{pfclause}{Clause}{Clauses}
\crefname{pfexercise}{Exercise}{Exercises}
\crefname{exhibit}{Exhibit}{Exhibits}
\crefname{section}{Section}{Sections}
\crefname{subsection}{Section}{Sections}
\crefname{chapter}{Chapter}{Chapters}
\crefname{equation}{Equation}{Equations}
\crefname{pfclausevar}{Clause}{Clauses}
\crefname{tcb@cnt@framework}{Framework}{Frameworks}

% Draft/standalone support: undefined refs render as ?? and are caught by the checker.
\endinput
